# Response headers for Cloudflare Pages. Vite copies this file into dist as is.
#
# Content-Security-Policy tells the browser what this page may load and where
# it may send data. Everything is limited to this site itself ('self'), so
# even if a bug let someone inject a script, the browser would refuse to run
# it or let it send a resume anywhere.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# File names under /assets contain a fingerprint of their contents, so they
# can be cached for a year: a new build gets new names.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
